@model MakeOfferForm
@{ var p = (ProductDetails)ViewBag.Product; decimal minimum = (decimal)ViewBag.MinimumPrice; ViewData["Title"] = "Trả giá " + p.Name; }
<div class="mt-4 mb-3"><a asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id">← @p.Name</a></div>
<div class="row justify-content-center"><div class="col-lg-7"><div class="panel offer-compose mb-5">
    <h1 class="offer-dialog-title">Đề xuất trả giá món đồ</h1>
    <div class="offer-product-summary my-3">
        @if (p.ImageIds.Count > 0) { <img src="/images/@p.ImageIds[0]" alt="" /> }
        else { <span class="offer-product-placeholder" aria-hidden="true"></span> }
        <div><strong>@p.Name</strong><span>Giá niêm yết @p.AskingPrice.ToString("N0") VNĐ · @p.Brand</span></div>
    </div>
    <form asp-action="Make" method="post"><input asp-for="ProductId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <label asp-for="Price" class="form-label fw-semibold"></label><div class="input-group"><input asp-for="Price" type="text" inputmode="numeric" autocomplete="off" data-vnd-price required class="form-control" autofocus /><span class="input-group-text">VNĐ</span></div><span asp-validation-for="Price" class="text-danger small"></span>
        <p class="form-text mt-2">Giá hợp lệ: @minimum.ToString("N0")–@((p.AskingPrice - 1).ToString("N0")) VNĐ. Tối đa 3 lần gửi giá cho món đồ này.</p>
        <div class="offer-compose-actions"><a class="btn btn-light" asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id">Hủy bỏ</a><button class="btn btn-wine" type="submit">Gửi đề xuất giá</button></div>
    </form>
</div></div></div>

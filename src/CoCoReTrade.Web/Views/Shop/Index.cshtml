@model IReadOnlyList<ProductCard>
@{
    ViewData["Title"] = "Khám phá";
    var f = (ProductFilter)ViewBag.Filter;
    var hasFilters = !string.IsNullOrWhiteSpace(f.Category) || !string.IsNullOrWhiteSpace(f.Brand) || !string.IsNullOrWhiteSpace(f.Size)
        || f.MinPrice.HasValue || f.MaxPrice.HasValue || f.MinCondition.HasValue || !string.IsNullOrWhiteSpace(f.Fulfillment);
}
<div class="page-heading"><div><span class="eyebrow">Tủ đồ tuyển chọn</span><h1 class="page-title">@(string.IsNullOrWhiteSpace(f.Category) ? "Tìm thấy món hợp gu" : $"Danh mục {f.Category}")</h1><p class="subtitle mb-0">Những món đồ độc bản, đã được CoCo kiểm định.</p></div></div>
<partial name="_ShopFilters" model="f" />
<div class="section-heading shop-results"><div><h2>@Model.Count sản phẩm</h2>@if (!string.IsNullOrWhiteSpace(f.Search)) { <p>Kết quả cho “@f.Search”</p> }</div>@if (hasFilters || !string.IsNullOrWhiteSpace(f.Search)) { <a class="text-link" asp-action="Index">Xóa bộ lọc</a> }</div>
<partial name="_ProductGrid" model="Model" />
